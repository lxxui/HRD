<!-- ==========================================
   E-CERTIFICATE REQUEST SECTION / MODAL
=========================================== -->
<div class="container-fluid px-4 py-3" id="certificate">
    <div class="card elearning-card border-0 shadow-sm p-4">

        <!-- Header -->
        <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-4">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle p-3 text-white" style="background: linear-gradient(135deg, #C8102E, #9B0B21);">
                    <i class="bi bi-award-fill fs-3"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-dark m-0">ระบบขอรับวุฒิบัตรผ่านการอบรม (E-Certificate System)</h5>
                    <small class="text-muted">กรอกข้อมูลเพื่อค้นหาหลักสูตรที่ผ่านการอบรมและออกใบรับรองอิเล็กทรอนิกส์</small>
                </div>
            </div>
            <div>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2 fs-7 fw-semibold">
                    <i class="bi bi-check-circle-fill me-1"></i> ออกวุฒิบัตรอัตโนมัติ (Auto Generation)
                </span>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left Side: Form กรอกขอรับวุฒิบัตร -->
            <div class="col-lg-7 border-end-lg">
                <form id="certRequestForm" onsubmit="return false;">

                    <div class="row g-3">
                        <!-- 1. รหัสพนักงาน & ชื่อ-นามสกุล -->
                        <div class="col-md-5">
                            <label class="form-label fs-7 fw-semibold text-dark">รหัสพนักงาน <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-0"><i class="bi bi-person-badge text-muted"></i></span>
                                <input type="text" class="form-control bg-light border-0 fs-7" placeholder="เช่น EMP-9045" value="EMP-202608" required>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label fs-7 fw-semibold text-dark">ชื่อ - นามสกุล <span class="text-danger">*</span></label>
                            <input type="text" class="form-control bg-light border-0 fs-7" placeholder="ระบุชื่อ-นามสกุลจริงสำหรับออกใบรับรอง" required>
                        </div>

                        <!-- 2. เลือกหลักสูตร (แมพจากแท็บ Data/ปฏิทิน) -->
                        <div class="col-12">
                            <label class="form-label fs-7 fw-semibold text-dark">หลักสูตรที่ผ่านการอบรม <span class="text-danger">*</span></label>
                            <select class="form-select bg-light border-0 fs-7" required>
                                <option value="" selected disabled>-- เลือกประเภท / รหัส / ชื่อหลักสูตร --</option>
                                <option value="COMP-001">[Compliance] COMP-001 : PDPA & Data Protection for Staff</option>
                                <option value="TECH-004">[Technical] TECH-004 : Basic UX/UI Design Concept</option>
                                <option value="SAFE-002">[Safety] SAFE-002 : ข้อปฏิบัติความปลอดภัยในโรงงานประจำปี 2026</option>
                            </select>
                        </div>

                        <!-- 3. วันที่อบรมเสร็จ -->
                        <div class="col-md-6">
                            <label class="form-label fs-7 fw-semibold text-dark">วันที่อบรมเสร็จ <span class="text-danger">*</span></label>
                            <input type="date" class="form-control bg-light border-0 fs-7" required>
                        </div>

                        <!-- 4. ช่องทางส่งวุฒิบัตร -->
                        <div class="col-md-6">
                            <label class="form-label fs-7 fw-semibold text-dark">ช่องทางรับวุฒิบัตร <span class="text-danger">*</span></label>
                            <select class="form-select bg-light border-0 fs-7" id="deliveryChannel" required>
                                <option value="email" selected>ส่งเข้า Email พนักงาน (PDF)</option>
                                <option value="download">ดาวน์โหลดไฟล์ทันที (Direct Download)</option>
                                <option value="line">ส่งแจ้งเตือนผ่าน LINE Official</option>
                            </select>
                        </div>

                        <!-- เพิ่มเติม: อีเมลสำหรับจัดส่ง (ถ้าเลือก email) -->
                        <div class="col-12" id="emailInputBox">
                            <label class="form-label fs-7 fw-semibold text-dark">อีเมลผู้รับ <span class="text-danger">*</span></label>
                            <input type="email" class="form-control bg-light border-0 fs-7" placeholder="example@company.com">
                        </div>

                        <!-- Action Buttons -->
                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-danger rounded-3 px-4 py-2 fw-medium shadow-sm me-2">
                                <i class="bi bi-file-earmark-pdf-fill me-1"></i> ออกวุฒิบัตร / ตรวจสอบสิทธิ์
                            </button>
                            <button type="reset" class="btn btn-light rounded-3 px-3 py-2 text-muted fs-7">ล้างข้อมูล</button>
                        </div>
                    </div>

                </form>
            </div>

            <!-- Right Side: Preview Certificate Badge & Recent Logs -->
            <div class="col-lg-5">
                <div class="p-3 rounded-4 bg-light h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold text-dark m-0 fs-7"><i class="bi bi-file-earmark-check text-success me-1"></i> ตัวอย่างวุฒิบัตรที่จะได้รับ</h6>
                            <span class="badge bg-success bg-opacity-10 text-success fs-8">Verified</span>
                        </div>

                        <!-- Mockup Certificate Card Preview -->
                        <div class="card border-0 shadow-sm rounded-3 p-3 text-center position-relative overflow-hidden"
                             style="background: linear-gradient(180deg, #FFFFFF 0%, #FFF5F5 100%); border: 2px solid #FEE2E2 !important;">
                            <div class="position-absolute top-0 end-0 p-2">
                                <i class="bi bi-shield-check text-danger opacity-25 fs-1"></i>
                            </div>

                            <small class="text-uppercase fw-bold text-muted fs-8 tracking-wider">Certificate of Completion</small>
                            <div class="fw-bold text-danger fs-6 my-1">ใบรับรองการผ่านการฝึกอบรม</div>
                            <div class="fs-8 text-secondary">มอบให้แก่</div>
                            <div class="fw-bold text-dark fs-6 my-1 border-bottom pb-2 text-truncate" id="previewName">คุณพนักงาน (กรอกข้อมูลซ้ายมือ)</div>
                            <small class="fs-8 text-muted d-block">ได้ผ่านการอบรมหลักสูตร</small>
                            <div class="fw-semibold text-dark fs-7 my-1" id="previewCourse">-- เลือกหลักสูตร --</div>

                            <div class="d-flex justify-content-between align-items-end mt-3 pt-2 border-top fs-8 text-muted">
                                <div>รหัส: <span class="fw-bold text-dark">CERT-2026-0892</span></div>
                                <div class="text-danger fw-bold"><i class="bi bi-qr-code"></i> Dynamic QR</div>
                            </div>
                        </div>
                    </div>

                    <!-- History Quick Links -->
                    <div class="mt-3 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fs-8 text-muted">ประวัติการขอวุฒิบัตรย้อนหลัง:</span>
                            <a href="#" class="fs-8 text-danger fw-semibold text-decoration-none">ดูทั้งหมด (3 รายการ)</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>