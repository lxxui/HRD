@{
    ViewData["Title"] = "ศูนย์การเรียนรู้ออนไลน์ (E-Learning Hub)";
}

<style>
    :root {
        --primary-red: #C8102E;
        --primary-dark: #9B0B21;
        --bg-slate: #F8FAFC;
        --card-radius: 16px;
    }

    body {
        background-color: var(--bg-slate);
        font-family: 'Kanit', sans-serif;
    }

    /* Modern Card & Glassmorphism */
    .elearning-card {
        border: none;
        border-radius: var(--card-radius);
        background: #ffffff;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
        transition: all 0.3s ease;
        overflow: hidden;
    }

        .elearning-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px -4px rgba(0, 0, 0, 0.1);
        }

    /* Course Banner Overlay */
    .course-cover {
        height: 160px;
        background-size: cover;
        background-position: center;
        position: relative;
    }

    .course-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 60%);
    }

    /* Micro-learning Reel Box */
    .reel-card {
        height: 220px;
        border-radius: 12px;
        background-size: cover;
        background-position: center;
        position: relative;
        cursor: pointer;
    }

    .reel-overlay {
        position: absolute;
        inset: 0;
        border-radius: 12px;
        background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 50%);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 12px;
    }

    .badge-soft-danger {
        background-color: #FFF0F2;
        color: var(--primary-red);
    }
</style>

<div class="container-fluid px-4 py-4">

    <!-- 1. Top Navbar / Header Area -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h4 class="fw-bold text-dark m-0 d-flex align-items-center gap-2">
                <i class="bi bi-mortarboard-fill text-danger"></i>
                E-Learning & Knowledge Center
            </h4>
            <p class="text-muted small m-0 mt-1">แหล่งเรียนรู้ออนไลน์สำหรับพนักงาน พัฒนาทักษะได้ทุกที่ ทุกเวลา</p>
        </div>
        <div class="d-flex gap-2">
            <!-- ปุ่มขอรับวุฒิบัตรแบบไม่ส่งค่า courseCode (เข้าหน้าแบบฟอร์มเปล่า) -->
            <a asp-controller="Elearning"
               asp-action="Certificate"
               class="btn btn-outline-danger btn-sm rounded-3 px-3 py-2 fw-medium">
                <i class="bi bi-award me-1"></i> ขอรับวุฒิบัตร
            </a>
            <a href="#dashboard" class="btn btn-danger btn-sm rounded-3 px-3 py-2 fw-medium">
                <i class="bi bi-bar-chart-line me-1"></i> สถิติการเรียน (HRD)
            </a>
        </div>
    </div>

    <!-- 2. Announcement Banner Carousel -->
    <div id="heroBanner" class="carousel slide mb-4 dashboard-card" data-bs-ride="carousel">
        <div class="carousel-inner rounded-4">
            <div class="carousel-item active" style="background: linear-gradient(135deg, #C8102E 0%, #7A0016 100%); min-height: 200px;">
                <div class="p-4 p-md-5 text-white d-flex flex-column justify-content-center h-100">
                    <span class="badge bg-white text-danger w-auto align-self-start mb-2 px-3 py-1 rounded-pill fw-bold">หลักสูตรแนะนำประจำเดือน</span>
                    <h2 class="fw-bold mb-2">Cybersecurity Awareness 2026</h2>
                    <p class="mb-3 text-white-50">เรียนรู้การป้องกันภัยคุกคามไซเบอร์และข้อปฏิบัติ PDPA สำหรับพนักงานทุกคน</p>
                    <div>
                        <button class="btn btn-light text-danger fw-bold rounded-pill px-4 shadow-sm">เข้าสู่บทเรียน <i class="bi bi-play-circle-fill ms-1"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Micro-learning Shorts -->
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold text-dark m-0 d-flex align-items-center gap-2">
                <i class="bi bi-collection-play-fill text-danger"></i> คลิปสั้นความรู้ (Micro-Learning)
            </h6>
            <a href="#" class="text-danger small fw-semibold text-decoration-none">ดูคลิปทั้งหมด <i class="bi bi-chevron-right"></i></a>
        </div>
        <div class="row g-3">
            <!-- Reel 1 -->
            <div class="col-6 col-md-3 col-xl-2">
                <div class="reel-card" style="background-image: url('https://picsum.photos/300/500?random=1');">
                    <div class="reel-overlay">
                        <span class="badge bg-danger w-auto align-self-start mb-1 fs-8">IT Quick Tips</span>
                        <span class="text-white fw-bold fs-7 text-truncate-2">วิธีตั้ง Password ให้ปลอดภัยใน 1 นาที</span>
                        <small class="text-white-50 fs-8"><i class="bi bi-play-fill"></i> 1.2k views</small>
                    </div>
                </div>
            </div>
            <!-- Reel 2 -->
            <div class="col-6 col-md-3 col-xl-2">
                <div class="reel-card" style="background-image: url('https://picsum.photos/300/500?random=2');">
                    <div class="reel-overlay">
                        <span class="badge bg-primary w-auto align-self-start mb-1 fs-8">Safety First</span>
                        <span class="text-white fw-bold fs-7 text-truncate-2">ข้อปฏิบัติความปลอดภัยในโรงงาน</span>
                        <small class="text-white-50 fs-8"><i class="bi bi-play-fill"></i> 850 views</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Main Course Catalog -->
    <div class="row g-4 mb-5">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark m-0 d-flex align-items-center gap-2">
                    <i class="bi bi-journal-bookmark-fill text-danger"></i> หลักสูตรอบรมทั้งหมด
                </h6>
                <!-- Filters -->
                <div class="d-flex gap-2">
                    <select class="form-select form-select-sm border-0 shadow-sm rounded-3">
                        <option selected>ทุกประเภทหลักสูตร</option>
                        <option>Compliance & Safety</option>
                        <option>Technical & IT</option>
                        <option>Management & Soft Skills</option>
                    </select>
                </div>
            </div>

            <div class="row g-3">
                <!-- Course Card 1 -->
                <div class="col-md-6">
                    <div class="card elearning-card h-100">
                        <div class="course-cover" style="background-image: url('https://picsum.photos/400/200?random=10');">
                            <div class="course-overlay d-flex justify-content-between p-3 align-items-start">
                                <span class="badge bg-danger">COMP-001</span>
                                <span class="badge bg-dark bg-opacity-75"><i class="bi bi-clock me-1"></i> 2 ชั่วโมง</span>
                            </div>
                        </div>
                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                            <div>
                                <div class="text-muted fs-8 mb-1">วิทยากร: ฝ่าย IT Security</div>
                                <h6 class="fw-bold text-dark mb-2">PDPA & Data Protection for Staff</h6>
                                <p class="text-muted fs-7 line-clamp-2">วัตถุประสงค์เพื่อเข้าใจข้อกฎหมายและการจัดเก็บข้อมูลส่วนบุคคลอย่างถูกต้องในองค์กร</p>
                            </div>
                            <div class="pt-3 border-top d-flex align-items-center justify-content-between">
                                <div class="d-flex gap-1">
                                    <span class="badge badge-soft-danger fs-8">Pre-Test</span>
                                    <span class="badge badge-soft-danger fs-8">Post-Test</span>
                                </div>
                                <div class="d-flex gap-1">
                                    <!-- ปุ่มรับวุฒิบัตรเฉพาะคอร์สนี้ -->
                                    <a asp-controller="Elearning"
                                       asp-action="Certificate"
                                       asp-route-courseCode="COMP-001"
                                       class="btn btn-sm btn-outline-danger rounded-pill px-2 fs-8 fw-medium"
                                       title="ขอรับวุฒิบัตรคอร์สนี้">
                                        <i class="bi bi-award me-1"></i> วุฒิบัตร
                                    </a>
                                    <button class="btn btn-sm btn-danger rounded-pill px-3 fs-8 fw-medium">เรียนเลย</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Course Card 2 -->
                <div class="col-md-6">
                    <div class="card elearning-card h-100">
                        <div class="course-cover" style="background-image: url('https://picsum.photos/400/200?random=11');">
                            <div class="course-overlay d-flex justify-content-between p-3 align-items-start">
                                <span class="badge bg-primary">TECH-004</span>
                                <span class="badge bg-dark bg-opacity-75"><i class="bi bi-clock me-1"></i> 3.5 ชั่วโมง</span>
                            </div>
                        </div>
                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                            <div>
                                <div class="text-muted fs-8 mb-1">วิทยากร: ฝ่ายระบบสารสนเทศ</div>
                                <h6 class="fw-bold text-dark mb-2">Basic UX/UI Design Concept</h6>
                                <p class="text-muted fs-7 line-clamp-2">การออกแบบหน้าตาโปรแกรมให้ใช้งานง่าย มินิมอล และเป็นสไตล์ Enterprise</p>
                            </div>
                            <div class="pt-3 border-top d-flex align-items-center justify-content-between">
                                <div class="d-flex gap-1">
                                    <span class="badge badge-soft-danger fs-8">มีวิดีโอ</span>
                                </div>
                                <div class="d-flex gap-1">
                                    <!-- ปุ่มรับวุฒิบัตรเฉพาะคอร์สนี้ -->
                                    <a asp-controller="Elearning"
                                       asp-action="Certificate"
                                       asp-route-courseCode="TECH-004"
                                       class="btn btn-sm btn-outline-danger rounded-pill px-2 fs-8 fw-medium"
                                       title="ขอรับวุฒิบัตรคอร์สนี้">
                                        <i class="bi bi-award me-1"></i> วุฒิบัตร
                                    </a>
                                    <button class="btn btn-sm btn-danger rounded-pill px-3 fs-8 fw-medium">เรียนเลย</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. Right Sidebar: Training Calendar & Monthly Tips -->
        <div class="col-lg-4 d-flex flex-column gap-4">

            <!-- ปฏิทินการจัดอบรม -->
            <div class="card elearning-card p-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark m-0"><i class="bi bi-calendar-event text-danger me-1"></i> ตารางอบรมเร็วๆ นี้</h6>
                    <a href="#" class="fs-8 text-muted">ดูทั้งหมด</a>
                </div>

                <div class="d-flex flex-column gap-2">
                    <div class="p-2 rounded-3 bg-light d-flex align-items-center gap-3">
                        <div class="text-center px-2 py-1 bg-white rounded-3 shadow-sm border" style="min-width: 50px;">
                            <div class="fw-bold text-danger fs-7">20</div>
                            <div class="fs-8 text-muted">ส.ค.</div>
                        </div>
                        <div>
                            <div class="fw-bold fs-7 text-dark">อบรมการใช้งานระบบ V-Fix</div>
                            <div class="fs-8 text-muted"><i class="bi bi-geo-alt"></i> ห้องประชุม 2 | 13:00 - 15:00</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- เกร็ดความรู้ประจำเดือน -->
            <div class="card elearning-card p-3">
                <h6 class="fw-bold text-dark mb-3"><i class="bi bi-lightbulb-fill text-warning me-1"></i> เกร็ดความรู้ประจำเดือน</h6>
                <div class="p-3 rounded-3" style="background-color: #FFFBEB; border: 1px solid #FCD34D;">
                    <span class="badge bg-warning text-dark mb-1">สิงหาคม 2569</span>
                    <h6 class="fw-bold text-dark fs-7">5 เทคนิคการใช้งาน Excel/C# ให้ประมวลผลเร็วขึ้น</h6>
                    <p class="fs-8 text-muted mb-2">รวมเทคนิคการลดภาระ Query Database และการเขียน Code อย่างมีประสิทธิภาพ...</p>
                    <a href="#" class="fs-8 text-warning-emphasis fw-bold text-decoration-none">อ่านเพิ่มเติม <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>

        </div>
    </div>

</div>