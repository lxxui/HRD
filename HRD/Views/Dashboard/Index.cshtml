@{
    ViewData["Title"] = "HRD Web Application - Enterprise Portal";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard_index.css" asp-append-version="true" />
}

<style>
    /* ----------------------------------------------------
           Enterprise Module Card Styles
        ---------------------------------------------------- */
    .custom-module-card {
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
        border-radius: 18px !important;
        background: #ffffff;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        overflow: hidden;
    }

        .custom-module-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 32px rgba(0, 0, 0, 0.08) !important;
        }

    /* Accent top bar based on category theme */
    .card-top-bar {
        height: 4px;
        width: 100%;
        opacity: 0.8;
        transition: all 0.3s ease;
    }

    .theme-danger .card-top-bar {
        background: linear-gradient(90deg, #C8102E 0%, #ff6b81 100%);
    }

    .theme-primary .card-top-bar {
        background: linear-gradient(90deg, #0d6efd 0%, #0dcaf0 100%);
    }

    .theme-success .card-top-bar {
        background: linear-gradient(90deg, #198754 0%, #20c997 100%);
    }

    .custom-module-card:hover .card-top-bar {
        height: 6px;
        opacity: 1;
    }

    /* กล่องใส่ภาพไอคอน - ขยายขนาดให้ชัดเจนมากขึ้น */
    .card-icon-wrapper {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        padding: 8px;
    }

    .theme-danger .card-icon-wrapper {
        background-color: #fef2f2;
        border: 1px solid #fee2e2;
    }

    .theme-primary .card-icon-wrapper {
        background-color: #eff6ff;
        border: 1px solid #dbeafe;
    }

    .theme-success .card-icon-wrapper {
        background-color: #f0fdf4;
        border: 1px solid #dcfce7;
    }

    .custom-module-card:hover .card-icon-wrapper {
        transform: scale(1.08) rotate(-2deg);
    }

    /* ขยายขนาดรูปภาพให้มองเห็นชัดเจน */
    .card-icon-img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.06));
    }

    /* Icon Bootstrap Fallback */
    .card-icon-wrapper i {
        font-size: 1.75rem;
    }

    /* Hover Micro-interactions */
    .icon-arrow {
        transition: transform 0.2s ease;
    }

    .custom-module-card:hover .icon-arrow {
        transform: translateX(4px);
    }
</style>

